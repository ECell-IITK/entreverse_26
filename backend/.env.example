# ── EntreVerse 2026 — Environment Variables ───────────────────────────────────
#
# Copy this file to .env and fill in the values before starting the server.
#   cp .env.example .env
#
# NEVER commit the .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://entreverse:CHANGE_ME@localhost:5432/entreverse?sslmode=disable

# Docker Compose uses these to create the postgres container:
POSTGRES_DB=entreverse
POSTGRES_USER=entreverse
POSTGRES_PASSWORD=CHANGE_ME

# ── Server ────────────────────────────────────────────────────────────────────

PORT=8080

# Set to "release" in production to disable debug output and localhost CORS.
GIN_MODE=debug

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# Localhost is always allowed when GIN_MODE != release.
# Example: ALLOWED_ORIGINS=https://entreverse.ecell.in
ALLOWED_ORIGINS=http://localhost:3000

# ── Admin authentication ──────────────────────────────────────────────────────

# Comma-separated list of username:bcryptHash pairs.
# Generate a hash:  go run ./cmd/genhash yourpassword
#
# Example with two admins (replace hashes with real ones):
#   ADMIN_CREDENTIALS=alice:$2a$12$HASH1,bob:$2a$12$HASH2
ADMIN_CREDENTIALS=admin:$2a$12$REPLACEME

# Secret used to sign JWTs. Use a long random string in production.
# Generate one:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# Token lifetime in hours (default: 8)
JWT_TTL_HOURS=8
