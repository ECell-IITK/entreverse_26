# ── EntreVerse 2026 — Environment Variables ───────────────────────────────────
#
# Copy this file to .env and fill in the values before starting the server.
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
#
# Production (Railway): set these as Railway service variables — no .env needed.

# ── Database ──────────────────────────────────────────────────────────────────

# Railway PostgreSQL plugin injects DATABASE_URL automatically.
# For local dev, set it manually.
DATABASE_URL=postgres://entreverse:CHANGE_ME@localhost:5432/entreverse?sslmode=disable

# ── Server ────────────────────────────────────────────────────────────────────

# Railway injects PORT automatically. Only set manually for local dev.
PORT=8080

# MUST be "release" in production.  Disables debug routes and locks CORS.
GIN_MODE=release

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# Must include the exact Vercel URL (and custom domain once mapped).
# Example:
#   ALLOWED_ORIGINS=https://ecelliitk.org,https://your-app.vercel.app
ALLOWED_ORIGINS=https://ecelliitk.org,https://your-app.vercel.app

# ── JWT ───────────────────────────────────────────────────────────────────────

# Secret used to sign JWTs.  MUST be a long random string in production.
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_MIN_32_CHARS

# Token lifetime in hours (default: 8)
JWT_TTL_HOURS=8

# ── Admin accounts ────────────────────────────────────────────────────────────
#
# Admin credentials are seeded directly into the database at startup —
# NO environment variable is needed for admin authentication.
#
# The following accounts are created automatically on first boot:
#
#   Username              Password
#   ──────────────────    ────────────────
#   rajc25@iitk.ac.in     Ecell@2026
#   anand@ecelliitk.com   Anand@Ecell26
#   hirani@ecelliitk.com  Hirani@Ecell26
#   mohit@ecell.com       Mohit@Ecell26
#   ecell@iitk.ac.in      EcellIITK@26
#
# To change a password after first boot, run directly on the DB:
#   UPDATE admins SET password_hash = '<new_bcrypt_hash>' WHERE username = '<email>';
# Generate a hash: go run ./cmd/genhash <newpassword>
